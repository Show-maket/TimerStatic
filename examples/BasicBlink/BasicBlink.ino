/*
  BasicBlink - Базовый пример мигания светодиодом
  
  Этот пример демонстрирует базовое использование библиотеки TimerStatic
  для мигания светодиодом без блокировки основного цикла.
  
  Схема подключения:
  - Светодиод подключен к пину 13 (или LED_BUILTIN)
  
  Создано DashyFox
  Этот пример находится в общественном достоянии.
*/

#include "TimerStatic.h"

//* Создаём таймер, который срабатывает каждые 1000мс (1 секунда)
Timer blinkTimer(1000, millis, []() {
  digitalWrite(LED_BUILTIN, !digitalRead(LED_BUILTIN));
});

void setup() {
  // Инициализируем пин светодиода
  pinMode(LED_BUILTIN, OUTPUT);
  
  // Опционально: включаем Serial для отладки
  Serial.begin(9600);
  Serial.println("TimerStatic Пример Базового Мигания");
}

void loop() {
  //* Проверяем, должен ли сработать таймер
  blinkTimer.check();
  
  //* Здесь может быть ваш другой код без блокировки
  //* Например, чтение датчиков, обработка данных и т.д.
}
